///https://hk.jdx.dev/builtins.html

amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local check_leaks = new Mapping<String, Step> {
  ["betterleaks"] = Builtins.betterleaks
  ["detect_private_key"] = Builtins.detect_private_key
  // ["global-echo-test"] {
  //   check = "echo 'running my global echo git-hook'"
  //   batch = true
  // }
}
local linters = new Mapping<String, Step> {
  ["bom"] = Builtins.byte_order_marker
  ["check_add_large_files"] = Builtins.check_added_large_files
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_symlinks"] = Builtins.check_symlinks
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
}
// Require your Signed-off-by trailer on commits
// Opt in per repo with: git config hk.requireSignoff true
local check_signoff = new Mapping<String, Step> {
  ["signoff"] {
    check = """
      [ "$(git config --type=bool --default=false hk.requireSignoff)" = true ] || exit 0
      want="Signed-off-by: $(git config user.name) <$(git config user.email)>"
      git interpret-trailers --parse "{{commit_msg_file}}" | grep -qxF "$want" && exit 0
      echo "missing '$want' trailer (use git commit -s)" >&2
      exit 1
      """
  }
}
// Block pushes containing commits whose subject has the word WIP (any case)
local check_wip = new Mapping<String, Step> {
  ["no_wip"] {
    check = """
      bad=$(while read -r lref lsha rref rsha; do
        case "$lsha" in *[!0]*) ;; *) continue ;; esac
        case "$rsha" in *[!0]*) git cat-file -e "$rsha^{commit}" 2>/dev/null || rsha= ;; *) rsha= ;; esac
        if [ -n "$rsha" ]; then
          git log --format='%h %s' "$rsha..$lsha"
        else
          git log --format='%h %s' "$lsha" --not --remotes
        fi
      done <<'HK_PUSH_EOF' | grep -iwF wip
      {{hook_stdin}}
      HK_PUSH_EOF
      ) || true
      [ -z "$bad" ] && exit 0
      printf 'refusing to push commits with WIP in the subject:\n%s\n' "$bad" >&2
      exit 1
      """
  }
}
hooks {
  ["commit-msg"] {
    steps = check_signoff
  }
  ["leaks"] {
    steps = check_leaks
  }
  ["check"] {
    steps {
      ...linters
      ...check_leaks
    }
  }
  ["lint"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["pre-commit"] {
    fix = false
    stash = "git"
    steps = check_leaks
  }
  ["pre-push"] {
    fix = false
    stash = "git"
    steps {
      ...check_leaks
      ...check_wip
    }
  }
}
