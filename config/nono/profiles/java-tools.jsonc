{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "java-tools",
    "version": "1.0.0",
    "description": "Java tools (maven,gradle)",
    "author": "Peter Merikan"
  },
  "filesystem": {
    "allow": [
      "$HOME/.m2/repository",
      "$HOME/.m2/wrapper/dists",
      // gradle
      "$HOME/.gradle/caches",
      "$HOME/.gradle/daemon",
      "$HOME/.gradle/native",
      "$HOME/.gradle/jdks",
      "$HOME/.gradle/wrapper/dists",
      "$HOME/.gradle/notifications",
      "$HOME/.gradle/.tmp",
      "$HOME/.gradle/android"
    ],
    "read": [
      "$HOME/.config/jgit"
    ],
    "read_file": [
      "$HOME/.m2/settings.xml"
    ],
    "write": [
      "$HOME/.m2/repository/.locks"
    ]
  }
}
