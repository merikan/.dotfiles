{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "extends": [
    "nolabs-ai/omp",
    "default-local"
  ],
  "meta": {
    "name": "omp-local",
    "version": "1.0.0",
    "description": "local omp harness profile",
    "author": "Peter Merikan"
  },
  "groups": {
    "include": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [],
    "read": []
  }
}
