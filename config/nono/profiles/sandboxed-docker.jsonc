{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "sandboxed-docker",
    "description": "sandboxed docker"
  },
  "filesystem": {
    "unix_socket_dir": [
      "$WORKDIR/.nono/d"
    ]
  },
  "session_hooks": {
    "before": {
      "script": "~/.config/nono/scripts/start-sandboxed-docker.sh",
      "timeout_secs": 30
    }
  }
}
