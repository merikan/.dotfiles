{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "extends": [
    "default",
    "java-tools",
    "sandboxed-docker"
  ],
  "meta": {
    "name": "default-local",
    "version": "1.0.0",
    "description": "default local profile to be extended",
    "author": "Peter Merikan"
  },
  "filesystem": {
    "read": [
      // agents
      "$HOME/.agents",
      "$HOME/.config/agents",
      "$HOME/.dotfiles/config/agents",
      // git
      "$HOME/.config/git",
      "$HOME/.dotfiles/config/git",
      "$HOME/.config/delta",
      "$HOME/.dotfiles/config/delta",
      // git hooks with hk
      "$HOME/.config/hk",
      "$HOME/.dotfiles/config/hk",
      // executables.
      "$HOME/.bun/bin",
      "$HOME/.cargo/bin",
      "$HOME/.local/share/go/bin",
      "$HOME/.local/share/mise/installs",
      "$HOME/.sdkman/candidates",
      "$HOME/bin"
    ],
    "read_file": [
      "$HOME/.CFUserTextEncoding" // macOS: read by CoreFoundation for locale setup
    ]
  }
}
