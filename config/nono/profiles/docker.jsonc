{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "meta": {
    "name": "docker",
    "description": "Docker tools"
  },
  "extends": [
    "sandboxed-docker"
  ],
  "filesystem": {
    "read_file": [
      "~/.docker/config.json"
    ],
    "bypass_protection": [
      "~/.docker/config.json"
    ],
    "unix_socket": [
      "$HOME/.lima/docker-nomount/sock/docker.sock"
    ]
  },
  "environment": {
    "set_vars": {
      "DOCKER_HOST": "unix://$HOME/.lima/docker-nomount/sock/docker.sock",
      "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/run/user/501/docker.sock"
    }
  }
}
